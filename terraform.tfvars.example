# Copy to terraform.tfvars (git-ignored) and fill in your own values.
aws_region   = "us-east-1"
project_name = "terraform-jenkins"

vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

# An existing public Route 53 hosted zone you own, and the record to create in it.
hosted_zone_name = "example.com"
jenkins_domain   = "jenkins.example.com"

# Your own SSH public key (e.g. contents of ~/.ssh/id_ed25519.pub).
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Only these CIDRs may SSH to the instance. Use your own IP, e.g. "203.0.113.10/32".
allowed_ssh_cidrs = ["203.0.113.10/32"]

instance_type = "t3.medium"
